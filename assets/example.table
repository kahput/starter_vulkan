table CullModeTable(name, display, num) {
    (NONE            "None"  0)
    (FRONT           "Front" 1)
    (BACK            "Back"  2)
    (FRONT_AND_BACK  "Both"  3)
}

Table IconTable(name, display, filepath) {
    (PLAY  "Play"  "assets/icons/PNG/White/1x/forward.png") 
    (PAUSE "PAUSE" "assets/icons/PNG/White/1x/pause.png") 
    (STOP  "STOP"  "assets/icons/PNG/White/1x/stop.png") 
}

enum CullMode {
    $for row in CullModeTable {
        CULL_MODE_${row.name},
    }

    CULL_MODE_MAX,
}

array cull_mode_to_string(String8) {
    $for row in CullModeTable {
        [CULL_MODE_${row.name}] = scomp(${row.display}), 
    }
}

struct IconMetadata {
    String8 name, display;
}

array icon_to_meta(IconMetadata) {
    $for row in IconTable {
        [ICON_${row.id}] = {
            .name = scomp(${str(row.id)}),
            .display =  = scomp(${row.display})
        },
    }
}

