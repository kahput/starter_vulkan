table CullModeTable(name, display, num) {
    (NONE            None  0)
    (FRONT           Front 1)
    (BACK            Back  2)
    (FRONT_AND_BACK  Both  3)
}

enum "CullMode": {
    for row in CullModeTable {
        CULL_MODE_$(row.name)
    }
    CULL_MODE_MAX,
}

array(String8) "cull_mode_to_string" {
    for row in CullModeTable {
        [CULL_MODE_$(row.id)] = str_comp("$(row.display)"),
    }
}
