
#version 450
#pragma shader_stage(vertex)

struct VertexData {
    vec3 position; 
    vec3 normal;
    vec2 uv;
    vec4 tangent;
};

layout(set = 0, binding = 0) readonly buffer VertexBlock {
    VertexData vertex_data[];
} batch;

out OutBlock {
    layout(location = 0) vec4 color;
} vs_output;

layout(push_constant) uniform ConstantBlock {
    mat4 view_projection;
};

void main() {
    VertexData vertex = batch.vertex_data[gl_VertexIndex];
    gl_Position = view_projection * vec4(vertex.position, 1.0);
    vs_output.color = vec4(vertex.position, 1.0);
}
