#version 450
#pragma shader_stage(fragment)

#extension GL_EXT_nonuniform_qualifier : enable

layout(set = 1, binding = 0) uniform sampler2D u_textures[32];

layout(location = 0) out vec4 out_color;

in ShaderInput {
    layout(location = 0) vec2 tex_coords;
    layout(location = 1) vec4 color;
    layout(location = 2) flat uint texture_id;
} fs_input;

void main() {
    vec4 sampled = texture(u_textures[fs_input.texture_id], fs_input.tex_coords) * fs_input.color;
    out_color = sampled; 
}
