#version 450
#pragma shader_stage(vertex)

#include "spatial.glsl"

layout(set = 0, binding = 1) readonly buffer VertexBlock {
    Vertex2 vertex_buffer[];
};

out OutBlock {
    layout(location = 0) vec2 tex_coords;
    layout(location = 1) flat uint texture_id;

    layout(location = 2) vec4 fill_color;
    layout(location = 3) vec4 border_color;
    layout(location = 4) float border_width;

    layout(location = 5) vec2 size; 
    layout(location = 6) vec2 local; 
    flat layout(location = 7) vec4 radii;
} vs_out;

const vec2 corners[4] = vec2[](vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0), vec2(1.0, 1.0));
const uint indices[6] = { 0, 2, 3, 0, 3, 1 };

void main() {
    Vertex2 vertex = vertex_buffer[gl_VertexIndex];
    gl_Position = frame.projection * frame.view * vec4(vertex.position, 0.0f, 1.0f);

    vs_out.tex_coords = vertex.uv;
    vs_out.texture_id = vertex.imageid;

    vs_out.fill_color = unpackUnorm4x8(vertex.fill_color);
    vs_out.border_color = unpackUnorm4x8(vertex.border_color);
    vs_out.border_width = vertex.border_width;

    vs_out.size = vertex.size;
    vs_out.local = corners[indices[gl_VertexIndex % 6]];
    vs_out.radii = vertex.radii;
}
